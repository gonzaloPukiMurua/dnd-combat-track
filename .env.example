# Copiar a .env (producción/local) o .env.development.local (desarrollo) y completar.
# Nunca commitear valores reales. .gitignore ya excluye .env*.

# Postgres. Con Supabase: DATABASE_URL = pooler de transacción (puerto 6543, ?pgbouncer=true),
# DIRECT_URL = pooler de sesión (puerto 5432), usado por las migraciones.
# Si la contraseña tiene caracteres como @, escribirlos codificados (%40).
DATABASE_URL="postgresql://USUARIO.REF:CONTRASEÑA@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USUARIO.REF:CONTRASEÑA@HOST:5432/postgres"

# Auth (NextAuth v5). Generar con: npx auth secret  (o openssl rand -base64 32)
AUTH_SECRET=

# OAuth (opcionales si solo usas email/contraseña)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Email transaccional (verificación de cuenta y recuperación de contraseña)
RESEND_API_KEY=
EMAIL_FROM=
